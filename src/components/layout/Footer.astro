---
import { profileConfig } from "@/config";
import { url } from "@/utils/url-utils";

const currentYear = new Date().getFullYear();
---

<div class="border-t border-black/10 dark:border-white/15 my-10 mx-32"></div>

<div class="rounded-2xl mb-12 flex flex-col items-center justify-center px-6">
  <div class="text-sm text-center text-50">
    <div class="flex gap-2 justify-center flex-wrap">
      &copy; <span>{currentYear}</span> {profileConfig.name}. All Rights Reserved.
      <span>/</span>
      <a class="link text-(--primary) font-medium" href={url("rss.xml")}>RSS</a>
      <span>/</span>
      <a class="link text-(--primary) font-medium" href={url("sitemap-index.xml")}>Sitemap</a>
    </div>
  </div>
</div>
